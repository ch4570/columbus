{"id":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)","path":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java","module":"src.main.java.org.springframework.core.io.DefaultResourceLoader","name":"getResource","qualname":"org.springframework.core.io.DefaultResourceLoader.getResource","kind":"method","start_line":154,"end_line":185,"signature":"@Override public Resource getResource(String location)","doc":"","parent_id":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader:class","language":"java","package":"org.springframework.core.io","parameter_types":["String"],"receiver_type":"","annotations":["@Override"],"local":false,"partial":false,"fidelity":"ast","source":"\t@Override\n\tpublic Resource getResource(String location) {\n\t\tAssert.notNull(location, \"Location must not be null\");\n\n\t\tfor (ProtocolResolver protocolResolver : getProtocolResolvers()) {\n\t\t\tResource resource = protocolResolver.resolve(location, this);\n\t\t\tif (resource != null) {\n\t\t\t\treturn resource;\n\t\t\t}\n\t\t}\n\n\t\tif (location.startsWith(\"/\")) {\n\t\t\treturn getResourceByPath(location);\n\t\t}\n\t\telse if (location.startsWith(CLASSPATH_URL_PREFIX)) {\n\t\t\treturn new ClassPathResource(location.substring(CLASSPATH_URL_PREFIX.length()), getClassLoader());\n\t\t}\n\t\telse if (location.startsWith(CLASSPATH_ALL_URL_PREFIX)) {\n\t\t\treturn new ClassPathAllResource(location.substring(CLASSPATH_ALL_URL_PREFIX.length()), getClassLoader());\n\t\t}\n\t\telse {\n\t\t\ttry {\n\t\t\t\t// Try to parse the location as a URL...\n\t\t\t\tURL url = ResourceUtils.toURL(location);\n\t\t\t\treturn (ResourceUtils.isFileURL(url) ? new FileUrlResource(url) : new UrlResource(url));\n\t\t\t}\n\t\t\tcatch (MalformedURLException ex) {\n\t\t\t\t// No URL -> resolve as resource path.\n\t\t\t\treturn getResourceByPath(location);\n\t\t\t}\n\t\t}\n\t}","excerpt_end_line":185,"source_hash":"a80386107541683cd5f929e479be638ad2821d1a2cb0d7518225b2740e62801c","truncated":false,"source_view_hash":"70d2a2af4717ca786e6f6084cd7f6192ab098fc685e9d170e513d5035addd625","receipt_compatible":false,"last_line_may_be_partial":false,"source_start_column":1,"source_start_offset":5204,"source_end_offset":6263,"seen_source_bytes":0,"freshness":"source_hash_verified","revision":"d34dc1de0265067e7716","unresolved_references":[{"source":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)","scope_id":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)","kind":"calls","name":"Assert.notNull","member":"notNull","receiver":"Assert","constructor":false,"path":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java","line":156,"evidence":"Assert.notNull(location, \"Location must not be null\")","resolved":false,"reason":"overloaded, external, ambiguous or unknown declaration"},{"source":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)","scope_id":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)::opaque:5323","kind":"calls","name":"getProtocolResolvers","member":"getProtocolResolvers","receiver":"","constructor":false,"path":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java","line":158,"evidence":"getProtocolResolvers()","resolved":false,"reason":"lambda, loop, catch or anonymous scope unsupported"},{"source":"src/main/java/org/springframework/core/io/DefaultResourceLoader.java::org.springframework.core.io.DefaultResourceLoader.getResource:method(String)","scope_id":"src/main/java/org/springfr